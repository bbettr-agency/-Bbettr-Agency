# ─────────────────────────────────────────────────────────────
# Bbettr Agency Client Portal — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# ─────────────────────────────────────────────────────────────

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser.
# Used for admin actions (creating client auth users, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://portal.bbettragency.com
NEXT_PUBLIC_APP_NAME="Bbettr Agency Portal"

# Resend — transactional NOTIFICATION emails (report/update/stage/action-required).
# Separate from Supabase Auth emails (magic link/reset), which go via Supabase SMTP.
# Server-only. Sender is portal@bbettragency.com (verified domain in Resend).
RESEND_API_KEY=re_your_resend_api_key

# ─────────────────────────────────────────────────────────────
# QuickBooks Online — invoicing on invoice-request approval.
# Server-only. Optional: if unset, invoicing is simply unavailable and the
# rest of the portal is unaffected. Create an app at developer.intuit.com.
# ─────────────────────────────────────────────────────────────
# OAuth2 app credentials (Intuit Developer → your app → Keys & credentials).
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
# "sandbox" while testing, "production" once live.
QBO_ENVIRONMENT=sandbox
# Must EXACTLY match a Redirect URI registered on the Intuit app.
QBO_REDIRECT_URI=https://portal.bbettragency.com/api/quickbooks/callback
# High-entropy secret used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate one with:  openssl rand -base64 32
QBO_TOKEN_SECRET=your-strong-random-secret

# ─────────────────────────────────────────────────────────────
# PayFast — payment links for INTERNATIONAL clients only (South African
# clients pay by EFT and never get a link). Server-only. Optional: if unset,
# international deals still get a QuickBooks invoice, just no payment link.
# ─────────────────────────────────────────────────────────────
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
# Passphrase set under Settings in the PayFast dashboard (used for signing).
PAYFAST_PASSPHRASE=your-payfast-passphrase
# "sandbox" while testing, "live" once approved.
PAYFAST_ENVIRONMENT=sandbox
