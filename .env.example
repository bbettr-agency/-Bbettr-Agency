# ─────────────────────────────────────────────────────────────
# Bbettr Agency Client Portal — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# ─────────────────────────────────────────────────────────────

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser.
# Used for admin actions (creating client auth users, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://portal.bbettragency.com
NEXT_PUBLIC_APP_NAME="Bbettr Agency Portal"

# Resend — transactional NOTIFICATION emails (report/update/stage/action-required).
# Separate from Supabase Auth emails (magic link/reset), which go via Supabase SMTP.
# Server-only. Sender is portal@bbettragency.com (verified domain in Resend).
RESEND_API_KEY=re_your_resend_api_key
